{
  "$defs": {
    "Scenario": {
      "additionalProperties": false,
      "properties": {
        "Scenario": {
          "pattern": "\\S",
          "title": "Scenario",
          "type": "string"
        },
        "Given": {
          "pattern": "\\S",
          "title": "Given",
          "type": "string"
        },
        "When": {
          "pattern": "\\S",
          "title": "When",
          "type": "string"
        },
        "Then": {
          "pattern": "\\S",
          "title": "Then",
          "type": "string"
        }
      },
      "required": [
        "Scenario",
        "Given",
        "When",
        "Then"
      ],
      "title": "Scenario",
      "type": "object"
    },
    "Story": {
      "additionalProperties": false,
      "properties": {
        "ID": {
          "pattern": "^[A-Za-z][A-Za-z0-9_-]*-[1-9][0-9]*$",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "pattern": "\\S",
          "title": "Title",
          "type": "string"
        },
        "Who": {
          "pattern": "\\S",
          "title": "Who",
          "type": "string"
        },
        "Action_What": {
          "pattern": "\\S",
          "title": "Action What",
          "type": "string"
        },
        "Benefit_Why": {
          "pattern": "\\S",
          "title": "Benefit Why",
          "type": "string"
        },
        "Priority": {
          "enum": [
            "priority:high",
            "priority:medium",
            "priority:low"
          ],
          "title": "Priority",
          "type": "string"
        },
        "acceptance_criteria": {
          "items": {
            "$ref": "#/$defs/Scenario"
          },
          "minItems": 1,
          "title": "Acceptance Criteria",
          "type": "array"
        },
        "tags": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Tags",
          "type": "array"
        },
        "labels": {
          "items": {
            "pattern": "\\S",
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        },
        "clarification_comment": {
          "pattern": "^$|\\S",
          "title": "Clarification Comment",
          "type": "string"
        }
      },
      "required": [
        "ID",
        "title",
        "Who",
        "Action_What",
        "Benefit_Why",
        "Priority",
        "acceptance_criteria",
        "tags",
        "labels",
        "clarification_comment"
      ],
      "title": "Story",
      "type": "object"
    },
    "StoryAlert": {
      "additionalProperties": false,
      "properties": {
        "severity": {
          "enum": [
            "INFO",
            "WARNING",
            "CRITICAL"
          ],
          "title": "Severity",
          "type": "string"
        },
        "rationale": {
          "pattern": "\\S",
          "title": "Rationale",
          "type": "string"
        }
      },
      "required": [
        "severity",
        "rationale"
      ],
      "title": "StoryAlert",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Final stories with authoritative, unique application-assigned IDs.",
  "properties": {
    "stories": {
      "items": {
        "$ref": "#/$defs/Story"
      },
      "minItems": 1,
      "title": "Stories",
      "type": "array"
    },
    "story_count": {
      "minimum": 1,
      "title": "Story Count",
      "type": "integer"
    },
    "ambiguity_score": {
      "maximum": 1.0,
      "minimum": 0.0,
      "title": "Ambiguity Score",
      "type": "number"
    },
    "estimated_complexity": {
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "title": "Estimated Complexity",
      "type": "string"
    },
    "alerts": {
      "items": {
        "$ref": "#/$defs/StoryAlert"
      },
      "title": "Alerts",
      "type": "array"
    }
  },
  "required": [
    "stories",
    "story_count",
    "ambiguity_score",
    "estimated_complexity",
    "alerts"
  ],
  "title": "StoryBatch",
  "type": "object"
}
